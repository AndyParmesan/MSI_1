@model IEnumerable<IssueTrackerProject.Models.Issue>
@using System.Text.Encodings.Web

@{
    ViewData["Title"] = "Issues Dashboard";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="toast-container position-fixed bottom-0 end-0 p-3">
    @if (TempData["Success"] != null)
    {
        <div id="successToast" class="toast align-items-center text-white bg-success border-0 shadow-lg" role="alert" aria-live="assertive" aria-atomic="true">
            <div class="d-flex">
                <div class="toast-body">
                    <i class="bi bi-check-circle-fill me-2"></i> @TempData["Success"]
                </div>
                <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
            </div>
        </div>
    }
</div>

<div class="container mt-5">
    <div class="text-center mb-4">
        <button class="btn btn-outline-primary shadow-sm" type="button" data-bs-toggle="collapse" data-bs-target="#chartCollapse">
            <i class="bi bi-pie-chart-fill me-2"></i> View System Health Analytics
        </button>
    </div>

    <div class="collapse" id="chartCollapse">
        <div class="row mb-4">
            <div class="col-md-8 mx-auto">
                <div class="card shadow-sm border-0">
                    <div class="card-header bg-dark text-white text-center">
                        <h5 class="mb-0">System Health Overview</h5>
                    </div>
                    <div class="card-body">
                        <div style="position: relative; height:40vh; width:100%">
                            <canvas id="combinedChart"></canvas>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row mb-4">
        <div class="col-md-3">
            <div class="card bg-primary text-white shadow-sm border-0 text-center p-3">
                <h6>Total Issues</h6>
                <h3>@ViewBag.TotalIssues</h3>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card bg-danger text-white shadow-sm border-0 text-center p-3">
                <h6>High Priority</h6>
                <h3>@ViewBag.HighPriority</h3>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card bg-info text-white shadow-sm border-0 text-center p-3">
                <h6>Active (Open)</h6>
                <h3>@ViewBag.OpenIssues</h3>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card bg-success text-white shadow-sm border-0 text-center p-3">
                <h6>Resolved</h6>
                <h3>@ViewBag.ResolvedIssues</h3>
            </div>
        </div>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center py-3">
            <h4 class="mb-0">Project Issues Dashboard</h4>
            <div class="d-flex align-items-center">
                <a asp-action="Create" class="btn btn-primary btn-sm px-3">Add New Issue</a>

                @if (User.IsInRole("Admin"))
                {
                    <form asp-action="ImportCSV" method="post" enctype="multipart/form-data" class="ms-2">
                        <input type="file" name="file" accept=".csv" class="d-none" id="csvUpload" onchange="this.form.submit()" />
                        <button type="button" class="btn btn-outline-success btn-sm" onclick="document.getElementById('csvUpload').click()">
                            Upload CSV
                        </button>
                    </form>
                }

                <a asp-action="ExportToExcel" class="btn btn-outline-light btn-sm ms-2">Download Excel</a>
            </div>
        </div>

        <div class="p-3 border-bottom bg-light">
            <div class="row g-2">
                <div class="col-md-8">
                    <input type="text" id="searchInput" class="form-control" placeholder="Search by title..." onkeyup="filterTable()">
                </div>
                <div class="col-md-4">
                    <select id="priorityFilter" class="form-select" onchange="filterTable()">
                        <option value="">All Priorities</option>
                        <option value="High">High</option>
                        <option value="Medium">Medium</option>
                        <option value="Low">Low</option>
                    </select>
                </div>
            </div>
        </div>

        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0" id="issueTable">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-4">ID</th>
                            <th>Title</th>
                            <th>Status</th>
                            <th>Priority</th> 
                            <th>Created</th>
                            <th class="text-end pe-4">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="ps-4 text-muted">#@item.Id</td>
                                <td><span class="fw-bold">@item.Title</span></td>
                                <td>
                                    @if(item.Status == "Open") { <span class="badge bg-info text-dark">Open</span> }
                                    else if(item.Status == "In Progress") { <span class="badge bg-warning text-dark">In Progress</span> }
                                    else { <span class="badge bg-success">Resolved</span> }
                                </td>
                                <td>
                                    @if (item.Priority == "High") { <span class="badge bg-danger">High</span> }
                                    else if (item.Priority == "Medium") { <span class="badge bg-warning text-dark">Medium</span> }
                                    else { <span class="badge bg-info text-dark">Low</span> }
                                </td>
                                <td>@item.CreatedAt.ToShortDateString()</td>
                                <td class="text-end pe-4">
                                    <button class="btn btn-sm btn-info text-white" 
                                            onclick="showDetails('@JavaScriptEncoder.Default.Encode(item.Title)', '@JavaScriptEncoder.Default.Encode(item.Description ?? "")', '@item.Status', '@item.Priority', '@item.ReportedBy', '@item.AssignedTo')">
                                        Details
                                    </button>
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-warning">Edit</a>
                                    
                                    @if (User.IsInRole("Admin")) {
                                        <form asp-action="Delete" asp-route-id="@item.Id" method="post" style="display:inline;" onsubmit="return confirm('Delete this issue?');">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm btn-outline-danger ms-1">Delete</button>
                                        </form>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="detailsModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-info text-white">
                <h5 class="modal-title" id="modalTitle"></h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p><strong>Description:</strong> <span id="modalDescription"></span></p>
                <p><strong>Status:</strong> <span id="modalStatus" class="badge"></span></p>
                <p><strong>Priority:</strong> <span id="modalPriority" class="fw-bold"></span></p>
                <hr />
                <p><strong>Reported By:</strong> <span id="modalReportedBy"></span></p>
                <p><strong>Assigned To:</strong> <span id="modalAssignedTo"></span></p>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            // Chart Initialization
            var chartInited = false;
            document.getElementById('chartCollapse').addEventListener('shown.bs.collapse', function () {
                if (!chartInited) {
                    var ctx = document.getElementById('combinedChart').getContext('2d');
                    new Chart(ctx, {
                        type: 'doughnut',
                        data: {
                            labels: ['Resolved', 'Open', 'High', 'Medium', 'Low'],
                            datasets: [
                                { data: [0, 0, @ViewBag.HighPriority, @ViewBag.MediumCount, @ViewBag.LowCount], backgroundColor: ['transparent', 'transparent', '#dc3545', '#ffc107', '#0dcaf0'] },
                                { data: [@ViewBag.ResolvedIssues, @ViewBag.OpenIssues, 0, 0, 0], backgroundColor: ['#198754', '#fd7e14', 'transparent', 'transparent', 'transparent'], weight: 0.5 }
                            ]
                        },
                        options: { 
                            responsive: true, 
                            maintainAspectRatio: false,
                            plugins: {
                                legend: { labels: { filter: (item) => !item.text.includes('transparent') } }
                            }
                        }
                    });
                    chartInited = true;
                }
            });

            // Toast Display
            var toastEl = document.getElementById('successToast');
            if (toastEl) new bootstrap.Toast(toastEl).show();
        });

        function filterTable() {
            const search = document.getElementById('searchInput').value.toLowerCase();
            const priority = document.getElementById('priorityFilter').value;
            document.querySelectorAll('#issueTable tbody tr').forEach(row => {
                const textMatch = row.cells[1].innerText.toLowerCase().includes(search);
                const prioMatch = priority === "" || row.cells[3].innerText.trim() === priority;
                row.style.display = (textMatch && prioMatch) ? "" : "none";
            });
        }

        function showDetails(title, desc, status, priority, reporter, assigned) {
            document.getElementById('modalTitle').innerText = title;
            document.getElementById('modalDescription').innerText = desc || "No description.";
            document.getElementById('modalReportedBy').innerText = reporter || "System";
            document.getElementById('modalAssignedTo').innerText = assigned || "Unassigned";

            const statusEl = document.getElementById('modalStatus');
            statusEl.innerText = status;
            statusEl.className = "badge " + (status === "Open" ? "bg-info text-dark" : (status === "In Progress" ? "bg-warning text-dark" : "bg-success"));

            const prioEl = document.getElementById('modalPriority');
            prioEl.innerText = priority;
            prioEl.className = "fw-bold " + (priority === "High" ? "text-danger" : (priority === "Medium" ? "text-warning" : "text-info"));

            new bootstrap.Modal(document.getElementById('detailsModal')).show();
        }
    </script>
}